// „Achievement Hunter“ duomenų modelis – 1 sprintas ir NI-2, NI-3, NI-5 (2 sprintas).
// Kode modeliai vadinami angliškai, o DB lentelės ir stulpeliai – lietuviškai
// (per @@map / @map), kaip numatyta projekto dokumentacijoje.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sąrašas „PasiekimoBusena“ (44 lentelė)
enum PasiekimoBusena {
  ATRAKINTAS
  NEATRAKINTAS

  @@map("pasiekimo_busena")
}
// Sąrašas „Sunkumas“ (44 lentelė, 3 sprintas)
enum Difficulty {
  EASY      @map("LENGVAS")
  MEDIUM    @map("VIDUTINIS")
  HARD      @map("SUNKUS")
  VERY_HARD @map("LABAI_SUNKUS")

  @@map("sunkumas")
}

// Sąrašas „PlanoPunktoBūsena“ (44 lentelė, 3 sprintas)
enum PlanItemStatus {
  NOT_DONE @map("NEATLIKTAS")
  DONE     @map("ATLIKTAS")

  @@map("plano_punkto_busena")
}
// Naudotojas – sukuriamas po pirmo sėkmingo prisijungimo per Steam (FR-02).
// Slaptažodis nesaugomas (AUT-06).
model User {
  id                Int       @id @default(autoincrement())
  // SteamID visada eilutė – JS number praranda 17 skaitmenų tikslumą
  steamId           String    @unique @map("steam_id")
  personaName       String    @map("slapyvardis")
  avatarUrl         String?   @map("avataro_url")
  // communityvisibilitystate == 3 (FR-04)
  profilePublic     Boolean   @default(true) @map("profilis_viesas")
  // Paskutinio sėkmingo bibliotekos atnaujinimo laikas, UTC (FR-11)
  lastLibrarySyncAt DateTime? @map("paskutinis_atnaujinimas") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("sukurta") @db.Timestamptz(3)

  games        UserGame[]
  achievements UserAchievement[]
  helpRequests HelpRequest[]
  plans        CollectionPlan[]
  @@map("naudotojas")
}

// Žaidimas – bendras visiems naudotojams
model Game {
  appId           Int      @id @map("app_id")
  name            String   @map("pavadinimas")
  iconUrl         String?  @map("ikonos_url")
  // null – dar nežinoma; false – Steam: „Requested app has no stats“ (FR-09)
  hasAchievements Boolean? @map("turi_pasiekimu")

  achievements Achievement[]
  users        UserGame[]
  plans        CollectionPlan[]

  @@map("zaidimas")
}

// Pasiekimas – žaidimo pasiekimo aprašas iš GetSchemaForGame
model Achievement {
  id          Int     @id @default(autoincrement())
  appId       Int     @map("app_id")
  apiName     String  @map("api_pavadinimas")
  name        String  @map("pavadinimas")
  description String? @map("aprasymas")
  iconUrl     String? @map("ikonos_url")

  // 3 sprintas (NI-9–NI-11). Bendri visiems naudotojams; Steam sinchronizacija jų neliečia.
  difficulty         Difficulty? @map("sunkumas")
  achievementType    String?     @map("tipas")
  // "PRIEINAMAS" | "NEPRIEINAMAS" | "NEZINOMA" – ribojama CHECK (migracijoje)
  availability       String?     @map("prieinamumas")
  availabilityReason String?     @map("prieinamumo_pagrindimas")
  assessedAt         DateTime?   @map("ivertinta") @db.Timestamptz(3)
  assessmentModel    String?     @map("vertinimo_modelis")
  // Steam GetGlobalAchievementPercentagesForApp, 0–100 (SDG-05)
  rarityPercent      Float?      @map("retumas_proc")
  rarityUpdatedAt    DateTime?   @map("retumas_atnaujintas") @db.Timestamptz(3)

  game  Game              @relation(fields: [appId], references: [appId], onDelete: Cascade)
  users UserAchievement[]
  explanation AchievementExplanation?
  guide Guide?
  sourceExcerpts SourceExcerpt[]
  helpRequests HelpRequest[]

  planItems PlanItem[]

  @@unique([appId, apiName])
  @@map("pasiekimas")
}

// Žaidimas konkretaus naudotojo bibliotekoje
model UserGame {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("naudotojo_id")
  appId           Int       @map("app_id")
  playtimeMinutes Int       @default(0) @map("zaidimo_laikas_min")
  // null – pasiekimai dar nesinchronizuoti, progresas nežinomas
  unlockedCount   Int?      @map("atrakinta")
  totalCount      Int?      @map("is_viso")
  // Paskutinio sėkmingo šio žaidimo pasiekimų atnaujinimo laikas, UTC
  lastSyncedAt    DateTime? @map("paskutinis_atnaujinimas") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [appId], references: [appId], onDelete: Cascade)

  @@unique([userId, appId])
  @@map("naudotojo_zaidimas")
}

// Konkretaus naudotojo pasiekimo būsena
model UserAchievement {
  id            Int             @id @default(autoincrement())
  userId        Int             @map("naudotojo_id")
  achievementId Int             @map("pasiekimo_id")
  status        PasiekimoBusena @map("busena")
  unlockedAt    DateTime?       @map("atrakinta_kada") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("naudotojo_pasiekimas")
}

// Sesijų lentelė, kurią naudoja connect-pg-simple (FR-02).
// Stulpelių pavadinimai privalo būti tokie, kokių tikisi biblioteka.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("sesija")
}

// NI-2 / DIS-01..02: vienas bendras paaiškinimas vienam pasiekimui.
// sourceHash leidžia neberodyti paaiškinimo pasikeitus Steam aprašui.
model AchievementExplanation {
  id            Int      @id @default(autoincrement())
  achievementId Int      @unique @map("pasiekimo_id")
  text          String   @map("tekstas")
  sourceHash    String   @map("saltinio_kontroline_suma") @db.VarChar(64)
  model         String   @map("modelis")
  createdAt     DateTime @default(now()) @map("sukurta") @db.Timestamptz(3)

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@map("pasiekimo_paaiskinimas")
}

enum SourceType {
  WIKI
  COMMUNITY_GUIDE @map("BENDRUOMENES_GIDAS")
  STEAM_GUIDE @map("STEAM_GIDAS")
  DISCUSSION @map("DISKUSIJA")
  OTHER @map("KITA")
  @@map("saltinio_tipas")
}

model ExternalSource {
  id Int @id @default(autoincrement())
  url String @unique
  title String @map("pavadinimas")
  type SourceType @map("tipas")
  fetchedAt DateTime @map("gauta") @db.Timestamptz(3)
  excerpts SourceExcerpt[]
  guides GuideSource[]
  @@map("isorinis_saltinis")
}

// Techninis kontekstas: to paties URL aktuali ištrauka skiriasi pagal pasiekimą.
model SourceExcerpt {
  id Int @id @default(autoincrement())
  achievementId Int @map("pasiekimo_id")
  sourceId Int @map("saltinio_id")
  queryHash String @map("uzklausos_suma") @db.VarChar(64)
  excerpt String @map("istrauka") @db.VarChar(4000)
  fetchedAt DateTime @map("gauta") @db.Timestamptz(3)
  achievement Achievement @relation(fields:[achievementId], references:[id], onDelete:Cascade)
  source ExternalSource @relation(fields:[sourceId], references:[id], onDelete:Cascade)
  @@unique([achievementId,sourceId])
  @@index([achievementId,queryHash,fetchedAt])
  @@map("saltinio_istrauka")
}

model Guide {
  id Int @id @default(autoincrement())
  achievementId Int @unique @map("pasiekimo_id")
  inputHash String @map("ivesties_suma") @db.VarChar(64)
  steps Json @map("zingsniai")
  model String @map("modelis")
  hasReliableInfo Boolean @default(true) @map("patikima_informacija")
  createdAt DateTime @default(now()) @map("sukurta") @db.Timestamptz(3)
  achievement Achievement @relation(fields:[achievementId], references:[id], onDelete:Cascade)
  sources GuideSource[]
  @@map("vadovas")
}

model GuideSource {
  guideId Int @map("vadovo_id")
  sourceId Int @map("saltinio_id")
  position Int @map("eiles_numeris")
  excerpt String @map("istrauka") @db.VarChar(4000)
  fetchedAt DateTime @map("gauta") @db.Timestamptz(3)
  guide Guide @relation(fields:[guideId], references:[id], onDelete:Cascade)
  source ExternalSource @relation(fields:[sourceId], references:[id], onDelete:Cascade)
  @@id([guideId,sourceId])
  @@unique([guideId,position])
  @@map("vadovo_saltinis")
}

// NI-5: private problem/answer pairs with immutable source context.
model HelpRequest {
  id Int @id @default(autoincrement())
  userId Int @map("naudotojo_id")
  achievementId Int @map("pasiekimo_id")
  inputHash String @map("ivesties_suma") @db.VarChar(64)
  problem String @map("problemos_aprasas") @db.VarChar(500)
  causes Json @map("galimos_priezastys")
  steps Json @map("sprendimo_zingsniai")
  sourceSnapshot Json @map("saltiniu_kopija")
  model String @map("modelis")
  createdAt DateTime @default(now()) @map("sukurta") @db.Timestamptz(3)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  achievement Achievement @relation(fields:[achievementId], references:[id], onDelete:Cascade)
  @@unique([userId,inputHash])
  @@index([userId,achievementId,createdAt])
  @@map("pagalbos_uzklausa")
}


// ---- 3 sprintas: „Achievement Hunting“ planai (NI-12, NI-13) ----

// RinkimoPlanas – struktūrinė klasė: kriterijai ir punktai kuriami ir trinami kartu su planu.
model CollectionPlan {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("naudotojo_id")
  appId     Int      @map("app_id")
  // Kuris DI modelis sudarė planą
  model     String   @map("modelis")
  createdAt DateTime @default(now()) @map("sukurta") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game          @relation(fields: [appId], references: [appId], onDelete: Cascade)
  criteria PlanCriteria?
  items    PlanItem[]

  @@index([userId, createdAt])
  @@map("rinkimo_planas")
}

// PlanoKriterijai – naudotojo nurodytos plano sąlygos (U14)
model PlanCriteria {
  // Ryšys 1:1 su planu – plano id kartu yra ir pirminis raktas
  planId            Int         @id @map("plano_id")
  // 15–600 min. – ribojama CHECK (GVS-16)
  availableMinutes  Int         @map("turimas_laikas_min")
  desiredDifficulty Difficulty? @map("norimas_sunkumas")
  achievementType   String?     @map("pasiekimo_tipas")

  plan CollectionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plano_kriterijai")
}

// PlanoPunktas – vienas plano žingsnis (U14, U16)
model PlanItem {
  id               Int            @id @default(autoincrement())
  planId           Int            @map("plano_id")
  achievementId    Int            @map("pasiekimo_id")
  // >= 1 – ribojama CHECK
  position         Int            @map("eiles_numeris")
  // > 0 – ribojama CHECK
  estimatedMinutes Int            @map("numatoma_trukme_min")
  justification    String         @map("pagrindimas")
  status           PlanItemStatus @default(NOT_DONE) @map("busena")
  completedAt      DateTime?      @map("atlikta_kada") @db.Timestamptz(3)

  plan        CollectionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  achievement Achievement    @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([planId, position])
  @@unique([planId, achievementId])
  @@map("plano_punktas")
}