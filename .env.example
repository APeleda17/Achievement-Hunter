# Nukopijuokite šį failą į server/.env ir įrašykite tikras reikšmes.
# server/.env yra .gitignore faile – jo necommitinkite.

# Steam Web API raktas: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# PostgreSQL (atitinka docker-compose.yml)
DATABASE_URL=postgresql://achievement:achievement@localhost:5432/achievement_hunter
# Atskira DB automatiniams testams (sukuriama automatiškai per docker/init-test-db.sql)
TEST_DATABASE_URL=postgresql://achievement:achievement@localhost:5432/achievement_hunter_test

# Ilga atsitiktinė eilutė sesijos slapukui pasirašyti (pvz. 64 simboliai)
SESSION_SECRET=

# Kliento (frontend) adresas – čia grąžinamas naudotojas po prisijungimo per Steam
APP_URL=http://localhost:5173

# Serverio prievadas
PORT=3000
